<?xml version="1.0" encoding="utf-8" ?>
<theme app="Y!Msgr" version="2" >
  <section caption="1" composited="0" height="800" id="MainWindow" resizable="1" width="300" >
    <dockpanel backcolor="backcolor" id="root">
      <customcontrol id="MyStatusPane" dock="top" width="260" height="54" />
      <dockpanel id="Main" dock="fill">
        <dockpanel id="PluginWnd" dock="bottom" width="100%" height="300" splitter="true" imagefile_splitter="splitterbarH.jpg">
          <customcontrol id="SlotMgrWnd" dock="fill" width="100%" />?
        </dockpanel>
        <dockpanel id="BuddyListArea" dock="fill" width="100%">
          <customcontrol id="BuddySearch" dock="top" width="100%" height="36" />
          <customcontrol id="PstnAcctInfo" dock="bottom" width="100%" height="22" />
          <customcontrol id="BuddyListView" dock="fill" width="100%" />
        </dockpanel>
      </dockpanel>
    </dockpanel>
  </section>
  <section caption="1" composited="0" height="800" id="main" resizable="1" width="1000" >
    <dockpanel backcolor="backcolor" id="root" >
      <dockpanel dock="top" >
        <imagebutton dock="left" imagefile="smile-button.PNG" />
        <combobox dock="left" height="25" width="50%" />
      </dockpanel>
      <dockpanel dock="top" spacersize="0" >
        <canvas dock="left" height="3" show="invisible" width="5" />
        <imagebutton dock="left" imagefile="m-pab_add1.png" />
        <canvas height="3" show="invisible" width="3" />
        <imagebutton dock="left" imagefile="m-pab_mlist1.png" type="toggle" />
        <imagebutton align_x="left" dock="left" imagefile="m-pab-abook.png" type="toggle" />
        <imagebutton align_y="center" dock="right" imagefile="m-msg-360.png" />
        <imagebutton align_y="center" dock="right" imagefile="m-msg-vmail.png" />
        <imagebutton align_y="center" dock="right" imagefile="m-msg-email.png" />
      </dockpanel>
      <dockpanel backcolor="0,128,128" dock="bottom" enabled="false" margin="2,2,2,2" outline="true" outlinecolor="defaulttextcolor" >
        <imagebutton enabled="true" imagefile="smile-button.png" />
        <edit align_y="center" dock="right" height="25" optional="false" width="90%" />
      </dockpanel>
      <dockpanel backcolor="255,255,128" dock="bottom" margin="3,3,3,3" >
        <image align_x="center" align_y="center" dock="bottom" imagefile="ad.png" />
      </dockpanel>
      <dockpanel dock="bottom" margin="5,5,5,5" >
        <dockpanel backcolor="0,0,0" dock="fill" minheight="70" />
        <textbutton font="defaultfontlargebold" show="visible" text="Plug-ins" textcolor="defaulttextcolor" />
      </dockpanel>
    </dockpanel>
  </section>
