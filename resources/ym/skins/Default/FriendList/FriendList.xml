                <event name="OnMouseEnter" >
                  <action targetid="InsiderIcon" state="2" />
                  <action targetid="Insider" state="2" />
                </event>
                <event name="OnMouseLeave" >
                  <action targetid="InsiderIcon" state="0" />
                  <action targetid="Insider" state="0" />
                </event>
                <event name="OnLButtonDown" >
                  <action targetid="InsiderIcon" state="1" />
                  <action targetid="Insider" state="1" />
                </event>
                <event name="OnLButtonUp" >
                  <action targetid="InsiderIcon" state="2" />
                  <action targetid="Insider" state="2" />
                </event>
              </textbutton>
              <textbutton id="Insider" dock="right" text="[Insider" margin="3,0,0,0" height="100%" type="toggle" optional="true" BkgndInvisibleOnNormal="true" imagefile="..\images\btn-insider-m.png" resizemargin="0,3,0,3" >
                <event name="OnMouseEnter" >
                  <action targetid="InsiderIcon" state="2" />
                  <action targetid="InsiderEdge" state="2" />
                </event>
                <event name="OnMouseLeave" >
                  <action targetid="InsiderIcon" state="0" />
                  <action targetid="InsiderEdge" state="0" />
                </event>
                <event name="OnLButtonDown" >
                  <action targetid="InsiderIcon" state="1" />
                  <action targetid="InsiderEdge" state="1" />
                </event>
                <event name="OnLButtonUp" >
                  <action targetid="InsiderIcon" state="2" />
                  <action targetid="InsiderEdge" state="2" />
                </event>
              </textbutton>
              <textbutton id="InsiderIcon" dock="right" margin="3,0,0,0" height="100%" type="toggle" BkgndInvisibleOnNormal="true" imagefile="..\images\btn-insider-l.png" resizemargin="3,3,0,3" iconalign_x="center" iconalign_y="center" icondock="center" iconfile="..\images\yinsider.png">
                <event name="OnMouseEnter" >
                  <action targetid="Insider" state="2" />
                  <action targetid="InsiderEdge" state="2" />
                </event>
                <event name="OnMouseLeave" >
                  <action targetid="Insider" state="0" />
                  <action targetid="InsiderEdge" state="0" />
                </event>
                <event name="OnLButtonDown" >
                  <action targetid="Insider" state="1" />
                  <action targetid="InsiderEdge" state="1" />
                </event>
                <event name="OnLButtonUp" >
                  <action targetid="Insider" state="2" />
                  <action targetid="InsiderEdge" state="2" />
                </event>
              </textbutton>
              <textbutton id="DisplayName" height="100%" optional="true" text="Kurt Hamilton" iconfile="..\images\online.png" font="defaultfontlargebold" style="style.button.dropdown" />
            </dockpanel>
            <dockpanel id="StatusTextArea" dock="top" width="100%" margin="0,0,0,0">
