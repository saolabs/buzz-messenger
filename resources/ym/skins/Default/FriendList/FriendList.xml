            textalign_x="center" textalign_y="bottom" textcolor="text_tab_checked" textcolor_down="text_tab_checked_d" textcolor_hover="text_tab_checked_h">
            <event name="OnButtonToggleOn" >
              <action targetid="" textcolor="text_tab_checked" textcolor_down="text_tab_checked_d" textcolor_hover="text_tab_checked_h" />
            </event>
            <event name="OnButtonToggleOff" >
              <action targetid="" textcolor="text_tab_unchecked" textcolor_down="text_tab_unchecked_d" textcolor_hover="text_tab_unchecked_h" />
            </event>
            </textbutton>
          </dockpanel>
          <dockpanel id="NewToolbarRight" dock="right" width="51%" >
            <textbutton id="MenuUpdates" dock="right" height="28" width="19" align_y="center" align_x="center" resizemargin="0,0,0,0" imagefile="TabMenuRight.png" show="hidden" />
            <textbutton id="BtnUpdates" width="100%" height="28" text="Y! Updates" align_y="center" align_x="center"
            margin="5,2,5,5" font="defaultfontlargebold" resizemargin="7,11,17,9" type="toggle" imagefile="TabRight.png"
            iconalign_x="center" iconalign_y="bottom" iconfile="new_updates.png" onestate="true"  icondock="left"
            textalign_x="center" textalign_y="bottom" textcolor="text_tab_unchecked" textcolor_down="text_tab_unchecked_d" textcolor_hover="text_tab_unchecked_h" >
              <event name="OnButtonToggleOn" >
                <action targetid="" textcolor="text_tab_checked" textcolor_down="text_tab_checked_d" textcolor_hover="text_tab_checked_h" />
              </event>
              <event name="OnButtonToggleOff" >
                <action targetid="" textcolor="text_tab_unchecked" textcolor_down="text_tab_unchecked_d" textcolor_hover="text_tab_unchecked_h" />
              </event>
            </textbutton>
          </dockpanel>
        </dockpanel>
        <!--<dockpanel id="BadgePanel" xpos="0" ypos="0" width="100%" margin="0,0,15,0" >
          <textbutton id="Badge" text="3" ypos="50" dock="right" imagefile="Badge.png" resizemargin="9,9,9,9" margin="4,3,3,3" textcolor="255,255,255" enable="false" />
        </dockpanel>-->
