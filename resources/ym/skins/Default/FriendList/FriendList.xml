            <dockpanel id="display_image_hover_effect" alpha="0" xpos="0" ypos="0" width="56" height="56" imagefile="DisplayImgOverlay.png" />
          </canvas>
        </dockpanel>

        <canvas dock="fill">
          <textbutton id="StatusArea.Background" xpos="0" ypos="0" width="100%" height="100%" />
          <dockpanel xpos="0" ypos="0" width="100%" height="100%" id="Status">
            <dockpanel dock="top" width="100%" height="18" clipedge="right">
              <!--<textbutton id="Email" margin="3,0,3,0" dock="right" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" style="style.button.bluetext" onestate="false" iconalign_x="center" iconalign_y="center" icondock="center" iconfile="..\images\email.png"/>-->
