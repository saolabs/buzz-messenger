      <!-- The search contact edit box area-->
      <dockpanel id="ContactSearchArea" dock="top" width="100%" height="26" margin="7,2,10,1" imagefile="SearchBar.png" resizemargin="40,7,10,7">
        <!-- Button to clear the search edit box-->
        <textbutton id="AddBuddy" align_y="center" dock="left"
                iconalign_x="center" iconalign_y="center" iconfile="addbuddy.png"
                style="style.button.addbuddy" BkgndInvisibleOnNormal="true" />
        <dockpanel id="EditArea" width="100%" margin="10,5,4,4" >
          <imagebutton id="SearchOptions" dock="left" imagefile="SearchOptions.png" onestate="true" enable="false" align_y="top" />
          <imagebutton id="ClearSearch" dock="right" imagefile="..\images\Clear.png" enable="false" align_y="top" show="hidden" />
          <!--edit dock="fill" drawborder="false"/-->
          <customcontrol id="ContactSearchBox" dock="fill" height="13">
          </customcontrol>
        </dockpanel>
