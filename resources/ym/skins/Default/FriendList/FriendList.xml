                  iconalign_x="center" iconalign_y="center" iconfile="..\images\arrow_plugins.png" />
        <textbutton id="PluginsArea.AddPlugins" font="defaultfontnormal" dock="right" align_y="center" text="[Add plugins" type="toggle" margin="10,4,10,4"
                    textalign_x="center" textalign_y="center" imagefile="..\images\btn-single-small.png" resizemargin="2,11,2,9" BkgndInvisibleOnNormal="true" />
      </dockpanel>
      <dockpanel backcolor="145,145,145" dock="fill" margin="1,1,1,1" spacer="2">
        <customcontrol id="EmptyFriendListPromo" show="hidden" dock="bottom" width="100%" minheight="300"/>
        <customcontrol id="Updates" text="Updates" show="hidden" dock="top" width="100%" height="100%"/>
        <customcontrol id="FriendList" dock="fill" minwidth="175" minheight="100" SelectedBkgnd="images\bg_selected.png" HoveredBkgnd="images\bg_hover.png" RowHeightSingle="19" RowHeightDouble="36" AvatarOffsetLeft="18" AvatarOffsetTop="2" OpiOffsetLeft="5" OpiOffsetTop="5" NameOffsetLeft="6" NameOffsetTop="3" StatusOffsetTop="18"  AvatarOffsetLeft1="18" OpiOffsetLeft1="5" NameOffsetLeft1="5"  />
      </dockpanel>
