                <dockpanel dock="fill" backcolor="145,145,145" margin="1,1,0,1">
                  <dockpanel dock="fill" backcolor="255,255,255" >
                    <dockpanel id="StatusDropDownEdit.BorderOutter" dock="top" width="100%" margin="1,1,1,1" backcolor="198,211,255" >
                      <dockpanel id="StatusDropDownEdit.Border" dock="top" width="100%" height="100%" margin="1,1,1,1" backcolor="181,211,255" >
                        <dockpanel dock="fill" backcolor="255,255,255" margin="0,1,0,0">
                          <edit id="StatusMsgEdit" dock="top" drawborder="false" height="14" multiline="true" font="defaultfontnormal">
                            <customattr name="tall height" value="27"/>
                            <customattr name="short height" value="14"/>
                            <event name="OnEnter" >
                              <action targetid="StatusTextButton" show="visible"/>
                            </event>
                            <event name="OnSetFocus">
                              <action targetid="StatusDropDownEdit.BorderOutter" backcolor="198,211,255" />
                              <action targetid="StatusDropDownEdit.Border" backcolor="181,211,255" />
                              <action targetid="StatusMsgURL.BorderOutter" backcolor="255,255,255" />
                              <action targetid="StatusMsgURL.Border" backcolor="dddddd" />
                            </event>
                          </edit>
                        </dockpanel>
                      </dockpanel>
                    </dockpanel>
                    <dockpanel dock="top" width="100%" height="18" margin="0,0,0,0">
                      <dockpanel dock="fill" id="StatusMsgURL.BorderOutter" margin="1,1,1,1" backcolor="255,255,255">
                        <dockpanel dock="fill" id="StatusMsgURL.Border" margin="1,1,1,1" backcolor="dddddd">
                          <dockpanel dock="fill" backcolor="255,255,255" margin="0,1,0,1">
                            <textbutton id="StatusMsgURLToggle" show="visible" res_id="1322" text="include web link" dock="top" width="100%" height="100%" textalign_x="left" BkgndInvisibleOnNormal="true" margin="3,0,3,0" textalign_y="center" textcolor="bfbfbf" textcolor_hover="666666" >
                              <event name="OnShow" >
                                <action targetid="StatusMsgURL" show="hidden"/>
                              </event>
                              <event name="OnHide" >
                                <action targetid="StatusMsgURL" show="visible"/>
                              </event>
                              <event name="OnClick">
                                <action targetid="StatusMsgURLToggle" show="hidden"/>
                              </event>
                            </textbutton>

                            <edit id="StatusMsgURL" dock="top" width="100%" height="100%" drawborder="false"  font="defaultfontnormal">
                              <event name="OnEnter" >
                                <action targetid="StatusTextButton" show="visible"/>
                              </event>
                              <event name="OnSetFocus">
                                <action targetid="StatusMsgURL.BorderOutter" backcolor="198,211,255" />
                                <action targetid="StatusMsgURL.Border" backcolor="181,211,255" />
                                <action targetid="StatusDropDownEdit.BorderOutter" backcolor="255,255,255" />
                                <action targetid="StatusDropDownEdit.Border" backcolor="dddddd" />
                              </event>
                            </edit>
                          </dockpanel>
                        </dockpanel>
                      </dockpanel>
                    </dockpanel>
                  </dockpanel>
                </dockpanel>
              </dockpanel>
            </dockpanel>
            <dockpanel id="PhoneBar" width="100%" height="18" margin="0,1,0,0" clipedge="none" dock="top" spacersize="3" >
              <textbutton id="Yahoo360" margin="5,2,5,2" show="hidden" dock="left"  text="Y! 360plus" textalign_x="left" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" optional="true" style="style.button.bluetext">
                <event name="OnClick" >
                  <action type = "url" url="http://vn.360plus.yahoo.com/"/>
                </event>
              </textbutton>
              <!--<textbutton id="Email" margin="3,0,3,0" dock="right" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" style="style.button.bluetext" onestate="false" iconalign_x="center" iconalign_y="center" icondock="center" iconfile="..\images\email.png"/>-->
              <textbutton id="Email" margin="3,0,3,0" dock="right" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" style="style.button.bluetext" onestate="false" iconalign_x="center" iconalign_y="center" icondock="center" iconfile="..\images\email.png"/>
              <!--<textbutton id="Insider" text="[Insider" margin="3,0,3,0" dock="right" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" style="style.button.bluetext" iconalign_x="center" iconalign_y="center" icondock="center" iconfile="..\images\yinsider.png"/>-->
              <textbutton id="GoMobile" margin="5,0,5,0" dock="left" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" style="style.button.bluetext" iconalign_x="right" iconalign_y="center" icondock="right" iconfile="im_forward_active.png"/>
              <textbutton id="Voice" margin="2,2,13,2" dock="left" res_id="623" text="[Yahoo! Voice" height="100%" BkgndInvisibleOnNormal="true" clipmode="clip" optional="true" textalign_x="left" iconalign_x="left" iconalign_y="center" icondock="left" iconfile="call_foward_inactive_icon.png" style="style.button.bluetext" resizemargin="2,11,11,3" imagefile="..\images\btn-single-dropdown.png" />
            </dockpanel>
          </dockpanel>
        </canvas>
      </dockpanel>
      <!-- system notification area-->
      <dockpanel id="SysNotification" dock="top" spacersize="5" margin="5,5,5,5" imagefile="info_bg.png" resizemargin="5,5,5,5" show="hidden">
        <image id="SysNotification.imgIcon" dock="left" align_y="top" show="hidden"/>
