                    <event name="OnLButtonDown" >
                      <action state="1" targetid="StatusText" type="normal" />
                    </event>
                    <event name="OnLButtonUp" >
                      <action state="2" targetid="StatusText" type="normal" />
                    </event>
                  </textbutton>
                </dockpanel>
                <textbutton id="StatusText" dock="fill" optional="false" width="100%" height="100%" BkgndInvisibleOnNormal="false" text="&lt;tell all your friends what&apos;up?&gt;" custom_draw="true" margin="4,0,4,0" style="style.conjoinedbutton.left" resizemargin="2,2,2,2" type="normal" iconfile="..\images\plugin.png" iconalign_x="left" iconalign_y="center" icondock="left" imagefile="btn-single-status.png" textcolor="menubartext">
                  <event name="OnHide" >
                    <action targetid="PhoneBar" show="hidden"/>
                    <action targetid="StatusEditArea" show="visible"/>
                  </event>
                  <event name="OnShow" >
                    <action targetid="StatusEditArea" show="hidden"/>
                    <action targetid="PhoneBar" show="visible"/>
                  </event>
                  <event name="OnClick" >
                    <action targetid="StatusTextButton" show="hidden"/>
                    <action targetid="StatusEditArea" show="visible"/>
                  </event>
                </textbutton>
              </dockpanel>
              <dockpanel id="StatusEditArea" dock="top" show="hidden" clipedge="right" width="100%" height="100%">
