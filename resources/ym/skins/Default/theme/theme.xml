<?xml version="1.0" encoding="utf-8" ?>

<theme>
  <styles>
    <!-- the imagefile should have both the active and inactive states in it (identical sizes) -->
      <style id="mainframewindow" imagefile="mainframewindow.png" logo="Yahoo!_Messenger.png"
                ellipsis="ellipsis.png" 
								resizemargin="4,44,4,5"
								resizemargin_top="120,0,60,0"
								resizemargin_bottom="3,0,9,0"
								resizemargin_left="0,0,0,9"
								resizemargin_right="0,0,0,9"
								active_font="defaultfontbold" active_textcolor="activemaincaption"
								inactive_font="defaultfontbold" inactive_textcolor="itactivemaincaption"
								icon_xpos="10" icon_ypos="7"
								title_xpos="-100" title_ypos="-100"/>

    <style id="framewindow" imagefile="framewindow.png"
								resizemargin="3,28,5,4"
								resizemargin_top="120,0,60,0"
								resizemargin_bottom="0,0,9,0"
								resizemargin_left="0,1,0,9"
								resizemargin_right="0,1,0,9"
								active_font="defaultfontbold" active_textcolor="activemaincaption"
								inactive_font="defaultfontbold" inactive_textcolor="itactivemaincaption"
								icon_xpos="10" icon_ypos="6"
								title_xpos="30" title_ypos="0"/>


    <!-- the imagefile should have both the active and inactive states in it (identical sizes) -->
    <style id="toolwindow"  imagefile="toolwindow.png"
								resizemargin="2,17,2,3"
								resizemargin_top="13,0,13,0"
								resizemargin_bottom="3,0,3,0"
								resizemargin_left="0,1,0,3"
								resizemargin_right="0,1,0,3"
								active_font="defaultfontnormal" active_textcolor="activecaption"
								inactive_font="defaultfontnormal" inactive_textcolor="itactivecaption"
                icon_xpos="5" icon_ypos="5"
								title_xpos="24" title_ypos="3"/>

    <!-- the closebutton's image file should have all 5 states in it -->
    <style id="closebutton"		imagefile="close.png"		align_x="right" xpos="2" ypos="4"/>
    <!-- the maximizebutton's image file should have all 5 states in it -->
    <style id="maximizebutton"	imagefile="max.png"	align_x="right" xpos="16" ypos="4"/>
    <!-- the restorebutton's image file should have all 5 states in it -->
    <style id="restorebutton"	imagefile="restore.png"	align_x="right" xpos="16" ypos="4"/>
    <!-- the minimizebutton's image file should have all 5 states in it -->
    <style id="minimizebutton"	imagefile="min.png"	align_x="right" xpos="30" ypos="4"/>
    <!-- the helpbutton's image file should have all 5 states in it -->
    <style id="helpbutton"		imagefile="marble.png"		align_x="right" xpos="49" ypos="4"/>
    <!-- the helpbutton's image file should have all 5 states in it -->
    <style id="dialog_helpbutton"		imagefile="help.png"		align_x="right" xpos="44" ypos="4"/>

    <!-- the toolclosebutton's image file should have all 5 states in it -->
    <style id="tool_closebutton" imagefile="tool_close.bmp" align_x="right" xpos="2" ypos="1"/>

    <!-- the systemmenu's image file should have all 4 images in it (close, maximize, minimize, restore) -->
    <style id="systemmenu"		imagefile="sys_menu.bmp"/>

    <!-- pushbuttons have all the same attributes that a textbutton does -->
    <!-- pushbutton images have 6 states -->
    <style id="pushbutton"  imagefile="pushbuttons.png" resizemargin="4,4,4,11" textcolor="defaulttextcolor" shadow="1" shadow_color="defaultshadowcolor" shadow_xoffset="1" shadow_yoffset="1" font="defaultfontnormal"/>

    <!-- images specified as 2 rows of button states, 1) unselected, 2) selected -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="radio"		imagefile="radio.png" font="defaultfontnormal"/>

    <!-- images specified as 3 rows of button states, 1) unchecked, 2) checked, 3) half-check -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="checkbox"    imagefile="checkbox.bmp" font="defaultfontnormal"/>

    <!-- combobox button images have 4 states (normal/hover/pushed/disabled) -->
    <style id="combobox"    imagefile="combo_back.bmp" resizemargin="2,2,2,2" imagefile_overlay="combo_arrow.bmp"/>

    <!-- groupbox images have 2 states (with text/without text) -->
    <style id="groupbox"	imagefile="groupbox.png" resizemargin="6,13,3,3" font="defaultfontnormal"/>

    <!-- headerctrl images have 4 states (normal/hover/pushed/disabled) -->
    <style id="headerctrl"  imagefile="headerctrl.bmp" resizemargin="2,2,2,2"/>

    <style id="listctrl"/>

    <!-- menu images -->
    <!-- imagefile: the background image -->
    <!-- imagefile_buttons: (the scroll buttons) Row1) UP, Row2) DOWN, each row has 4 states (normal/hover/pushed/disabled) -->
    <!-- imagefile_baritem: (state images for a menu bar item) 4 states (normal/hover/pushed/disabled) -->
    <!-- imagefile_menuitem: (state images for a menu item) 4 states (normal/hover/pushed/disabled) -->
    <!--resizemargin_baritem="299,0,9,0"-->
    <style id="menu"		
							    imagefile="menu_bg.png"
								imagefile_buttons="menu_scroll.bmp"
								imagefile_menuitem="menuitem.png"
								imagefile_mainbaritem="mainmenubar.png"
								imagefile_baritem="menubar.png" />


    <!-- progressbar images have 2 states (frame/fill) -->
    <style id="progressbar" imagefile="progressbar.bmp" resizemargin="5,5,5,5"/>

    <!-- tab button images have 5 states in them (normal/hover/pushed/hotpushed/disabled) -->
    <style id="tabctrl"		imagefile="tab_border" imagefile_buttons="tabs.png"/>

    <style id="rebar"/>
    <style id="editctrl"/>

    <!-- toolbar buttons have 5 states in them (normal/hover/pushed/hotpushed/disabled) -->
    <style id="toolbar"		imagefile="toolbar_buttons.png" imagefile_separator="toolbar_sep.bmp"/>

    <!-- status bar images both have a single image -->
    <style id="statusbar"	imagefile="statusbar.bmp" resizemargin="2,0,0,0" imagefile_grip="grabber.png"/>

    <!-- images specified as 2 rows of button states, top row for up, bottom row for down -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="scrollbar_v" imagefile="scroll_vbg.png"
								imagefile_buttons="scroll_buttons.png"
								imagefile_overlay="scroll_varrows.png"
								imagefile_thumb="scroll_thumb.png"
								imagefile_grip="scroll_v_grip.png"/>

    <!-- images specified as 2 rows of button states, top row for left, bottom row for right -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="scrollbar_h" imagefile="scroll_hbg.png"
								imagefile_buttons="scroll_buttons.png"
								imagefile_overlay="scroll_harrows.png"
								imagefile_thumb="scroll_thumb_h.png"
								imagefile_grip="scroll_h_grip.png"/>

    <!-- trackbar_v images have 3 rows of button states, 1) NO point, 2) LEFT point, 3) RIGHT point -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="trackbar_v"	imagefile="trackbar_vthumb.bmp"/>

    <!-- trackbar_v images have 3 rows of button states, 1) NO point, 2) UP point, 3) DOWN point -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="trackbar_h"	imagefile="trackbar_hthumb.bmp"/>

    <!-- updown images have 2 rows of button states, top row for UP, bottom row for DOWN -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="updown"		imagefile="up_down.bmp"/>

    <!-- leftright images have 2 rows of button states, top row for LEFT, bottom row for RIGHT -->
    <!-- there are 4 states per button (normal/hover/pushed/disabled) -->
    <style id="leftright"	imagefile="left_right.bmp"/>

    <style id="tooltip"/>

  </styles>

