<?xml version="1.0" encoding="utf-8" ?>
<theme app="Y!Msgr" version="2" >

  <style id="style.CC.actionbutton" type="toggle" dock="left" margin="5,4,5,4" minwidth="28" BkgndInvisibleOnNormal="true" font="defaultfontnormal" textcolor="button" textcolor_disable="button_ds" textcolor_hover="button_h" textalign_x="center" textalign_y="center" icondock="center" iconalign_x="center" iconalign_y="center" resizemargin="4,1,4,1" imagefile="..\images\btn-single-small.png"/>
  <style id="style.CC.actionbuttontext" type="toggle" dock="top" font="defaultfontnormal" font_hover="defaultfontunderline" textcolor="text_hyperlink" textcolor_disable="button_ds" textalign_x="left" textalign_y="center" height="16" optional="false"/>
  <style id="style.CC.SingleButton" font="defaultfontnormal" textcolor="button" textcolor_disable="button_ds" textcolor_hover="button_h" textalign_x="center" textalign_y="center" />
  <style id="style.CC.vitality_expand_toggler" type="toggle" dock="top" margin="5,4,5,4" minwidth="28" font="defaultfontnormal" textcolor="button" textcolor_disable="button_ds" textcolor_hover="button_h" textalign_x="center" textalign_y="center" icondock="center" iconalign_x="center" iconalign_y="center" resizemargin="4,1,4,1" />

  <section id="ContactCard" layered="false" caption="false" maximizable="false" minimizable="false" systemmenu="false">
    <dockpanel id="popup" minwidth="254" backcolor="236,237,224">
      <customattr name="CornerArc" value="0" />
      <customattr name="DelayShowTime" value="500" />
      <customattr name="DimissTime" value="4000" />
      <dockpanel id="background" dock="fill" imagefile="background.png" resizemargin="26,50,26,10">
        <dockpanel id="Main" dock="fill" width="100%" height="100%" margin="4,0,4,2">
          <!-- Title area-->
          <dockpanel dock="top" id="TitleArea" width="100%" height="26" margin="3,0,0,0">
            <!-- Close button -->
            <dockpanel dock="right" height="100%" margin="0,2,0,2">
              <imagebutton id="Close" dock="right" type="4" imagefile="..\images\close.png">
                <event name="OnClick" >
                  <action command="close" section="ContactCard" type="popup" />
                </event>
              </imagebutton>
            </dockpanel>
            <dockpanel id="NetworkLogoArea" dock="left" show="hidden" align_y="center" margin="0,0,5,0">
              <image id="NetworkLogo" dock="left" width="16" height="16"/>
            </dockpanel>
            <dockpanel dock="fill" clipedge="right" maxwidth="200">
              <compositelabel dock="left" id="Name" label1="DisplayName" label2="BuddyID"  separator=""  textcolor="displaynametextcolor" font="defaultfontlargenormal" height="100%"   textalign_x="left" textalign_y="center" optional="true"/>
              <label show="hidden" dock="left" id="DisplayName" text="[Kurt Hamilton" textcolor="displaynametextcolor" font="defaultfontlargenormal" height="100%"   textalign_x="left" textalign_y="center" />
              <label show="hidden" dock="left" id="BuddyID" text="[Kurt Hamilton" textcolor="displaynametextcolor" font="defaultfontlargenormal" height="100%"   textalign_x="left" textalign_y="center" />
              <dockpanel dock="left" id="SumoImgspacer" width="2" height="100%" />
              <textbutton id="SumoImg" dock="left" align_y="center" show="visible" iconalign_x="center" iconalign_y="center" icondock="center" onestate="true"  iconfile="..\sumo\1.png" imagefile="..\images\btn-single-small_tr.png" type="toggle" height="14" resizemargin="2,9,2,8" margin="3,0,3,0" BkgndInvisibleOnNormal="true">
                <customattr name="Launch URL" value="sumo about" />
              </textbutton>
            </dockpanel>
          </dockpanel>
          <dockpanel id="Main" dock="fill" margin="4,4,4,4">
            <!-- Middle area with the friend icon and action buttions -->
            <dockpanel dock="top">
              <dockpanel id="DisplayImageArea" dock="right" width="96" height="96">
                <image id="DisplayImage" dock="fill" imagefile="..\images\DefaultFriendIcon.png" height="96" width="96" />
                <dockpanel id="AvatarSection" show="hidden" dock="fill">
                  <dockpanel width="5" dock="left"/>
                  <customcontrol id="Avatar" height="128" width="86" />
                </dockpanel>
              </dockpanel>
              <!-- The buttons for top 3 actions -->
              <dockpanel id="Actions.MainActionsPanel" dock="top" width="100%" margin="4,0,0,2">
                <textbutton id="Actions.Video" iconfile="card-VideoButton.png" style="style.CC.actionbutton" />
                <textbutton id="Actions.Call" iconfile="card-CallButton.png" style="style.CC.actionbutton" />
                <textbutton id="Actions.SMS" iconfile="card-SmsButton.png" style="style.CC.actionbutton" />
              </dockpanel>
              <dockpanel id="DisplayImageAreaSpacer" dock="right" width="7" />
              <dockpanel id="Actions.ActionsPanel" dock="fill" margin="0,0,0,0" clipedge="right">
                <customattr name="MaxNumOfBtnToShow" value="4" />
                <textbutton id="Actions.CallMobile" text="Call" style="style.CC.actionbuttontext" width="100%"/>
                <textbutton id="Actions.CallHome" text="Call" style="style.CC.actionbuttontext" width="100%"/>
                <textbutton id="Actions.CallWork" text="Call" style="style.CC.actionbuttontext" width="100%"/>
                <textbutton id="Actions.CallANumber" text="Call" style="style.CC.actionbuttontext" width="100%"/>
                <textbutton id="Actions.Email" text="[Send Email" style="style.CC.actionbuttontext" width="100%"/>
                <textbutton id="Actions.Conference" text="[Conference" style="style.CC.actionbuttontext"/>
                <textbutton id="Actions.Photosharing" text="[Photosharing" style="style.CC.actionbuttontext"/>
                <textbutton id="Actions.SendFile" text="[Send File" style="style.CC.actionbuttontext"/>
                <textbutton id="Actions.Webcam" text="[Webcam" style="style.CC.actionbuttontext"/>
                <dockpanel height="8" width="1" dock="top" />

                <textbutton id="Actions.ViewProfile" res_id="11111" text="[View Profile" dock="bottom" style="style.CC.actionbuttontext">
                  <customattr name="Required" value="true" />
                  <customattr name="SingleButton" value="true" />
                  <!-- To indicate that this button is a stand alone button so don't change the background image-->
                </textbutton>
                <textbutton id="Actions.EditContact" text="[Edit Contact..." type="toggle" dock="bottom" style="style.CC.actionbuttontext">
                  <customattr name="Required" value="true" />
                  <customattr name="SingleButton" value="true" /> <!-- To indicate that this button is a stand alone button so don't change the background image-->
                </textbutton>
              </dockpanel>
            </dockpanel>

            <!-- Vertical spacer -->
            <dockpanel dock="top" height="5" />
			      <dockpanel dock="top" imagefile="\menu_separator.png" height="2" />

            <!-- Visibility setting button -->
            <textbutton dock="top" align_x="center" id="Actions.Visibility" text="[You appear online to this contact" BkgndInvisibleOnNormal="true" type="toggle" height="19" imagefile="..\images\btn-single-small.png" resizemargin="10,1,10,1" style="style.CC.SingleButton" iconalign_x="right" iconalign_y="center" icondock="right" onestate="true" iconfile="..\images\single_arrow_down.png" />

            <!-- Vertical spacer -->
            <dockpanel dock="top" height="2" />

            <!-- Vitality banner -->
            <dockpanel id="VitalityBannerContainer" dock="top" width="100%">
              <dockpanel backcolor="158,158,158" dock="top" width="100%" margin="1,1,1,0">
                <dockpanel backcolor="255,255,255" dock="top" width="100%" margin="1,1,1,0">
                  <dockpanel id="BuddyStatusArea" backcolor="236,236,236" dock="top" width="100%" margin="3,0,3,0">
                    <label id="IdleStatusTimer" dock="top" width="100%" height="20" font="defaultfontnormal" textcolor="cctextcolor" textalign_x="left" textalign_y="center" />
                    <customcontrol id="CustomUserStatus" height="20" width="100%"  dock="top"/>
                  </dockpanel>
                  <customcontrol id="VitalityBanner" dock="top" height="67" width="100%" />                    
                </dockpanel>
              </dockpanel>
              <dockpanel id="VitalityBanner.BottomBorder" targetid="VitalityBanner.BottomBorder" backcolor="158,158,158" show="hidden" dock="top" height="1" width="100%" />
              <textbutton id="VitalityBanner.Expand" dock="top" width="100%" height="13" imagefile="..\images\btn-middle-small.png" type="autotoggle" iconfile="..\images\up_down_expand_toggle.png" style="style.CC.vitality_expand_toggler">
                <event name="OnHide" >
                  <action targetid="VitalityBanner.BottomBorder" show="visible" />
                </event>
                <event name="OnShow" >
                  <action targetid="VitalityBanner.BottomBorder" show="hidden" />
                </event>  
              </textbutton>
            </dockpanel>
          </dockpanel>
        </dockpanel>
      </dockpanel>
    </dockpanel>
  </section>
  <section id="MyContactCard" layered="false" caption="false" maximizable="false" minimizable="false" systemmenu="false">
    <dockpanel id="popup" minwidth="254">
      <customattr name="CornerArc" value="0" />
      <customattr name="DimissTime" value="60000" />
      <dockpanel id="background" dock="fill" imagefile="background.png" resizemargin="26,50,26,10">
        <dockpanel id="Main" dock="fill" width="100%" height="100%" margin="4,0,4,2">
          <!-- Title area-->
          <dockpanel dock="top" id="TitleArea" width="100%" height="26" margin="3,0,0,0">
            <!-- Close button -->
            <dockpanel dock="right" height="100%" margin="0,2,0,2">
              <imagebutton id="Close" dock="right" type="4" imagefile="..\images\close.png">
                <event name="OnClick" >
                  <action command="close" section="ContactCard" type="popup" />
                </event>
              </imagebutton>
            </dockpanel>
            <label dock="left" id="DisplayName" text="[Kurt Hamilton" textcolor="displaynametextcolor" font="defaultfontlargenormal" height="100%"   textalign_x="left" textalign_y="center" />
            <dockpanel dock="left" id="SumoImgspacer" width="2" height="100%" />
            <textbutton id="SumoImg" dock="left" align_y="center" show="visible" iconalign_x="center" iconalign_y="center" icondock="center" onestate="true"  iconfile="..\sumo\1.png" imagefile="..\images\btn-single-small_tr.png" type="toggle" height="14" resizemargin="2,9,2,8" margin="3,0,3,0" BkgndInvisibleOnNormal="true">
              <customattr name="Launch URL" value="sumo about" />
            </textbutton>            
          </dockpanel>
          <dockpanel id="Main" dock="fill" margin="4,4,4,4">
            <!-- Middle area with the friend icon and action buttions -->
            <dockpanel dock="top">
              <dockpanel id="DisplayImageArea" dock="right" width="96" height="96">
                <image id="DisplayImage" dock="fill" imagefile="..\images\DefaultFriendIcon.png" height="96" width="96" />
                <dockpanel id="AvatarSection" show="hidden" dock="fill">
                  <dockpanel width="5" dock="left"/>
                  <customcontrol id="Avatar" height="128" width="86" />
                </dockpanel>
              </dockpanel>
              <dockpanel id="DisplayImageAreaSpacer" dock="right" width="10" />
              <dockpanel dock="fill" margin="0,0,0,0">
                <textbutton id="Actions.DisplayImage" text="[Display Image..." res_id="346" style="style.CC.actionbuttontext"/>
                <dockpanel dock="top" height="8"/>
                <textbutton id="Actions.EditContact" text="[Contact Details"   res_id="11200" style="style.CC.actionbuttontext"/>
                <textbutton id="Actions.ViewProfile" text="[Edit My Profile"   res_id="2034" style="style.CC.actionbuttontext"/>
                <textbutton id="Actions.AccountInfo" text="[Account Info"      res_id="1290" style="style.CC.actionbuttontext"/>
                <textbutton id="Actions.SumoInfo" text="[Power User Benefits"  res_id="1291" style="style.CC.actionbuttontext" />
                <textbutton id="VitalityBanner.PreferenceLink" text="[My Sharing Preference..." res_id="271" dock="bottom" style="style.CC.actionbuttontext" />
              </dockpanel>
            </dockpanel>

            <!-- Vertical spacer -->
            <dockpanel dock="top" height="4" />

            <!-- Vitality banner -->
            <dockpanel id="VitalityBannerContainer" dock="top" width="100%">
              <dockpanel backcolor="158,158,158" dock="top" width="100%" margin="1,1,1,0">
                <dockpanel backcolor="255,255,255" dock="top" width="100%" margin="1,1,1,0">
                  <dockpanel backcolor="236,236,236" dock="top" width="100%" margin="3,0,3,0">
                    <label id="IdleStatusTimer" dock="top" width="100%" height="20" font="defaultfontnormal" textcolor="cctextcolor" textalign_x="left" textalign_y="center" />
                    <customcontrol id="CustomUserStatus" height="20" width="100%"  dock="top"/>
                  </dockpanel>
                  <customcontrol id="VitalityBanner" dock="top" height="67" width="100%" />
                </dockpanel>
              </dockpanel>
              <dockpanel id="VitalityBanner.BottomBorder" backcolor="158,158,158" show="hidden" dock="top" height="1" width="100%" />
              <textbutton id="VitalityBanner.Expand" dock="top" width="100%" height="13" imagefile="..\images\btn-middle-small.png" type="autotoggle" iconfile="..\images\up_down_expand_toggle.png" style="style.CC.vitality_expand_toggler">
                <event name="OnHide" >
                  <action targetid="VitalityBanner.BottomBorder" show="visible" />
                </event>
                <event name="OnShow" >
                  <action targetid="VitalityBanner.BottomBorder" show="hidden" />
                </event>
              </textbutton>
            </dockpanel>
          </dockpanel>
        </dockpanel>
      </dockpanel>
    </dockpanel>
  </section>
  <section id="ContactCardOverlay" layered="true" alpha="255" composited="true" caption="false" maximizable="false" minimizable="false" resizable="false" systemmenu="false">
    <dockpanel id="popup" width="300" height="38" margin="12,0,0,0" >
      <customattr name="MoreActivateTags" value="DisplayImage,StatusIcon,Status.MoreLeft,Status.MoreRight,DisplayImage.Frame" />
      <customattr name="Height" value="38" />
      <customattr name="MarginLeft" value="3" />
      <customattr name="MarginTop" value="-1" />
      <customattr name="MarginBottom" value="0" />
      <customattr name="MarginRight" value="0"/>
      <customattr name="Resizable" value="true" />
      <customattr name="DimissTime" value="500" />
      <customattr name="DelayShowTime" value="200" />
      <customattr name="FadeInOnShowSteps" value="5" />
      <customattr name="FadeInOnShowDelay" value="100" />
      <customattr name="FadeInTransitionFrame" value="0,50,100,150,200,255" />
      <customattr name="FadeInTransitionButtons" value="0,50,100,150,200,255" />
      <customattr name="ControlsTabOrder" value ="DisplayImage.Frame,Actions.Menu" />
      <!--<dockpanel id="left-of-image" dock="left" width="26" height="100%" />-->
      <dockpanel id="image-frame" dock="left" width="38" height="38" >
        <imagebutton id="DisplayImage.Frame" imagefile="Frame.png" type="toggle" />
      </dockpanel>
      <dockpanel id="ActionButtons" dock="fill" height="100%" margin="0,5,5,0" >
        <imagebutton id="Actions.Menu" dock="right" align_x="right" align_y="top" imagefile="MenuButton.png" type="toggle" />
      </dockpanel>
    </dockpanel>
  </section>

</theme>